---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import KineticCanvas from './KineticCanvas';
import ProjectArt from './ProjectArt.astro';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const es = lang === 'es';
const other = es ? 'en' : 'es';
const projects = (await getCollection('projects', ({ data }) => data.locale === lang)).sort((a, b) => a.data.order - b.data.order);
const projectUrl = (slug: string) => es ? `/es/trabajos/${slug}/` : `/en/work/${slug}/`;
const copy = es ? {
  nav: ['Proyectos', 'Perfil', 'Contacto'],
  hero: 'PARA UNA WEB MÁS HUMANA',
  statement: ['Precisión de ingeniería.', 'Ojo entrenado para la UX.'],
  role: 'Senior Frontend Engineer: interfaces con IA en React, Next.js y TypeScript.',
  view: 'Ver proyectos', scroll: 'Deslizá para explorar',
  work: 'Proyectos destacados', from: 'De la idea', to: 'al producto.',
  capabilities: 'Lo que construyo', capabilitiesTitle: 'Interfaces rápidas, accesibles y listas para IA.',
  about: 'Ingeniero primero. Con criterio de UX en cada interfaz.',
  experience: 'Experiencia',
  contact: 'Hablemos', available: 'Disponible para trabajo remoto',
  resume: 'Descargar CV', note: 'Hecho con Astro, Claude Code y Codex · 2026',
  details: 'Ver caso', source: 'Código', live: 'Demo', preparing: 'Caso en preparación',
} : {
  nav: ['Work', 'About', 'Contact'],
  hero: 'FOR A MORE HUMAN WEB',
  statement: ['Engineering precision.', 'A trained eye for UX.'],
  role: 'Senior Frontend Engineer building AI-powered interfaces with React, Next.js and TypeScript.',
  view: 'View work', scroll: 'Scroll to explore',
  work: 'Selected work', from: 'From idea', to: 'to product.',
  capabilities: 'What I build', capabilitiesTitle: 'Interfaces that are fast, accessible and AI-ready.',
  about: 'Engineer first. With a UX mindset in every interface.',
  experience: 'Experience',
  contact: 'Let’s talk', available: 'Available for remote work',
  resume: 'Download résumé', note: 'Built with Astro, Claude Code & Codex · 2026',
  details: 'Read case', source: 'Code', live: 'Live demo', preparing: 'Case in preparation',
};
const clients = [
  'Sony', 'Santander', 'Vetsource',
  'Attentive', 'Vidoomy', 'Aquia', 'Fox Rent a Car',
  'MM411', 'CPI Group', 'Albor',
];
const capabilities = es ? [
  ['01', 'Arquitectura frontend', 'React, Next.js y TypeScript a escala: micro-frontends, rendimiento y SEO.'],
  ['02', 'Ingeniería de interfaces', 'Design systems, componentes accesibles (WCAG 2.1 AA), motion y dashboards con muchos datos.'],
  ['03', 'Interfaces con IA', 'Funcionalidades con LLMs, generación de imágenes y agentes (OpenAI, Gemini, Claude), convertidas en experiencias claras.'],
  ['04', 'Fullstack y entrega', 'APIs en Node.js y Express cuando el producto lo necesita; CI/CD, testing E2E y liderazgo técnico.'],
] : [
  ['01', 'Frontend architecture', 'React, Next.js and TypeScript at scale: micro-frontends, performance and SEO.'],
  ['02', 'Interface engineering', 'Design systems, accessible components (WCAG 2.1 AA), motion and data-heavy dashboards.'],
  ['03', 'AI-powered interfaces', 'LLM features, image generation and agents (OpenAI, Gemini, Claude) turned into clear user experiences.'],
  ['04', 'Fullstack & delivery', 'Node.js and Express APIs when the product needs them; CI/CD, E2E testing and technical leadership.'],
];
const aiSteps = es ? [
  ['01', 'Explorar', 'Uso Claude y Codex para recorrer codebases, comparar enfoques y bajar specs antes de escribir código.'],
  ['02', 'Construir', 'Claude Code y Codex como pair programmers: componentes, refactors, tests y documentación, revisados línea por línea.'],
  ['03', 'Verificar', 'Los agentes corren builds, tests E2E, auditorías de accesibilidad y Lighthouse antes de cada entrega.'],
  ['04', 'Extender', 'Servidores MCP, skills y agentes propios que conectan la IA con las herramientas reales del equipo.'],
] : [
  ['01', 'Explore', 'I use Claude and Codex to map codebases, compare approaches and turn ideas into specs before writing code.'],
  ['02', 'Build', 'Claude Code and Codex as pair programmers: components, refactors, tests and docs, reviewed line by line.'],
  ['03', 'Verify', 'Agents run builds, E2E tests, accessibility audits and Lighthouse before anything ships.'],
  ['04', 'Extend', 'MCP servers, skills and custom agents that plug AI into the team’s real tools.'],
];
const aiTools = ['Claude Code', 'Codex', 'Claude API', 'MCP', 'Agents & skills', 'Cursor', 'OpenAI', 'Gemini'];
---
<BaseLayout lang={lang} title="Daniel De Ruvo · Senior Frontend Engineer" description={es ? 'Daniel De Ruvo: Senior Frontend Engineer. Interfaces rápidas, accesibles y con IA en React, Next.js y TypeScript.' : 'Daniel De Ruvo: Senior Frontend Engineer building fast, accessible, AI-powered interfaces with React, Next.js and TypeScript.'} alternate={`/${other}/`}>
  <div class="site-shell">
    <header class="header">
      <a class="wordmark" href={`/${lang}/`} aria-label="ddra home">ddra<span aria-hidden="true"></span></a>
      <nav aria-label={es ? 'Navegación principal' : 'Main navigation'}>
        <a href="#selected-work">{copy.nav[0]}</a>
        <a href="#ai">{es ? 'IA' : 'AI'}</a>
        <a href="#about">{copy.nav[1]}</a>
        <a href="#contact">{copy.nav[2]}</a>
      </nav>
      <p class="header-role">Frontend · Interfaces · AI</p>
      <a class="language-link" href={`/${other}/`} data-language={other} lang={other} aria-label={es ? 'Switch to English' : 'Cambiar a español'}>{other.toUpperCase()}</a>
      <button class="menu" type="button" aria-label={es ? 'Abrir navegación' : 'Open navigation'} aria-expanded="false"><i></i><i></i></button>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-frame">
          <div class="hero-meta"><span class="meta-index">01</span><span>Interfaces<br />Systems<br />AI</span></div>
          <div class="hero-copy">
            <h1 id="hero-title"><span class="build">BUILD</span><span class="human">{copy.hero}</span></h1>
            <p class="statement">{copy.statement[0]}<br />{copy.statement[1]}</p>
            <p class="role">{copy.role}</p>
            <a class="primary-cta" href="#selected-work"><span>{copy.view}</span><span aria-hidden="true">↗</span></a>
          </div>
          <div class="type-scene" aria-hidden="true">
            <KineticCanvas client:load />
            <span class="scene-glyph glyph-b">B</span><span class="scene-glyph glyph-u">U</span><span class="scene-glyph glyph-i">I</span><span class="scene-glyph glyph-l">L</span><span class="scene-glyph glyph-d">D</span>
            <span class="scene-label label-a">TYPE<br />REACTS<br />TO YOU</span>
            <span class="scene-label label-b">DDRA / 2026</span>
          </div>
          <div class="hero-bottom"><span>{es ? <>Interfaces pensadas para personas:<br />rápidas, accesibles, listas para IA.</> : <>Interfaces built for people:<br />fast, accessible, AI-ready.</>}</span><span class="scroll-cue">{copy.scroll} <b>↓</b></span></div>
          <div class="hero-progress" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </div>
      </section>

      <section id="clients" class="clients-marquee" data-motion-section aria-labelledby="clients-title">
        <h2 id="clients-title" class="clients-label">{es ? 'Empresas con las que trabajé' : 'Companies I’ve worked with'}</h2>
        <div class="clients-viewport">
          <div class="clients-track">
            {[0, 1].map((copyIndex) => (
              <ul class="clients-list" role="list" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
                {clients.map((client) => <li>{client}</li>)}
              </ul>
            ))}
          </div>
        </div>
      </section>

      <div class="kinetic-band" aria-hidden="true" data-motion-section><div class="kinetic-track">{[0, 1].map(() => <span>FRONTEND <i>×</i> INTERFACES <i>×</i> AI PRODUCTS <i>×</i> </span>)}</div></div>

      <section id="selected-work" class="selected-work" data-motion-section aria-labelledby="work-title">
        <div class="section-kicker">02 / {copy.work}</div>
        <h2 id="work-title" data-reveal>{copy.from}<br /><em>{copy.to}</em></h2>
        <div class="work-list">
          {projects.map(({ data }, index) => (
            <article class="project-row" data-motion-section data-reveal>
              <ProjectArt kind={data.slug} index={index} />
              <span class="project-number">0{index + 1}</span>
              <div class="project-main"><span class="project-eyebrow">{data.stack.slice(0, 3).join(" / ")}</span><h3>{data.title}</h3><p>{data.tagline}</p></div>

              {data.caseStudyReady ? <a class="project-action" href={projectUrl(data.slug)} aria-label={`${copy.details}: ${data.title}`}>↗</a> : data.links.demo ? <a class="project-action" href={data.links.demo} target="_blank" rel="noreferrer" aria-label={`${copy.live}: ${data.title}`}>↗</a> : <span class="project-pending" title={copy.preparing}>·</span>}
            </article>
          ))}
        </div>
      </section>

      <section class="proof" data-motion-section aria-label={es ? 'En números' : 'By the numbers'}>
        <div data-reveal><strong>6+</strong><span>{es ? 'años construyendo productos digitales' : 'years building digital products'}</span></div>
        <div data-reveal><strong>15</strong><span>{es ? 'personas en el equipo liderado' : 'people on the team I led'}</span></div>
        <div data-reveal><strong>10+</strong><span>{es ? 'clientes internacionales' : 'international clients'}</span></div>
        <div data-reveal><strong>40%</strong><span>{es ? 'menos tiempo de entrega de MVP, hasta' : 'faster MVP delivery, up to'}</span></div>
      </section>

      <section class="capabilities" data-motion-section aria-labelledby="capabilities-title">
        <div class="section-kicker">03 / {copy.capabilities}</div>
        <h2 id="capabilities-title" data-reveal>{copy.capabilitiesTitle}</h2>
        <div class="capability-grid">{capabilities.map(([number, title, text]) => <article data-reveal><div class={`capability-symbol symbol-${number}`} aria-hidden="true"><i></i><i></i><i></i></div><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
      </section>

      <section id="ai" class="ai-workflow" data-motion-section aria-labelledby="ai-title">
        <div class="section-kicker">04 / {es ? 'Cómo trabajo con IA' : 'How I build with AI'}</div>
        <h2 id="ai-title" data-reveal>{es ? <>Desarrollo con agentes<br /><em>en el loop.</em></> : <>I ship with AI agents<br /><em>in the loop.</em></>}</h2>
        <p class="ai-intro" data-reveal>{es ? 'Claude Code y Codex son parte de mi día a día: me ayudan a entregar más rápido sin bajar la vara de calidad. En Making Sense llevé estos flujos al equipo y redujimos hasta un 40% el tiempo de entrega de MVPs.' : 'Claude Code and Codex are part of my daily workflow: they help me ship faster without lowering the quality bar. At Making Sense I brought these workflows to my team and we cut MVP delivery time by up to 40%.'}</p>
        <ol class="ai-steps" role="list">
          {aiSteps.map(([number, title, text]) => <li data-reveal><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}
        </ol>
        <div class="ai-footer" data-reveal>
          <ul class="ai-tools" role="list" aria-label={es ? 'Herramientas de IA' : 'AI tools'}>{aiTools.map(tool => <li>{tool}</li>)}</ul>
          <p class="ai-proof"><span aria-hidden="true"></span>{es ? 'Este sitio se construyó con Claude Code y Codex, incluida su QA.' : 'This site was built with Claude Code and Codex, QA included.'}</p>
        </div>
      </section>

      <section id="about" class="about" data-motion-section aria-labelledby="about-title">
        <div class="about-orbits" aria-hidden="true"><i></i><i></i><i></i></div>
        <div><div class="section-kicker">05 / {copy.nav[1]}</div><h2 id="about-title" data-reveal>{copy.about}</h2></div>
        <div class="about-details" data-reveal>
          <p>{es ? 'Soy Daniel De Ruvo, Senior Frontend Engineer. Construyo interfaces rápidas y accesibles en React, Next.js y TypeScript, y bajo en el stack a APIs en Node.js e integraciones de IA cuando el producto lo necesita.' : 'I’m Daniel De Ruvo, a Senior Frontend Engineer. I build fast, accessible interfaces in React, Next.js and TypeScript, and I go down the stack to Node.js APIs and AI integrations when a product needs it.'}</p>
          <p>{es ? 'En Making Sense lidero un equipo de desarrollo de 15 personas para clientes internacionales, incluidos Sony y Attentive. Mi base en UX hace que lo que construyo no solo funcione: también se entienda y se use bien.' : 'At Making Sense, I lead a 15-person development team for international clients, including Sony and Attentive. My UX background means what I ship doesn’t just work: it’s clear and easy to use.'}</p>
        </div>
      </section>

      <section class="experience" data-motion-section aria-labelledby="experience-title">
        <div class="section-kicker">06 / {copy.experience}</div>
        <h2 id="experience-title" data-reveal>{es ? 'De la dirección técnica al detalle.' : 'From technical direction to the details.'}</h2>
        <div class="experience-list">
          <div data-reveal><span>2022 — {es ? 'Actualidad' : 'Present'}</span><strong>Making Sense</strong><p>Senior Frontend Developer / Tech Lead · UX Development</p></div>
          <div data-reveal><span>2023 — 2024</span><strong>Coderhouse</strong><p>{es ? 'Profesor de Desarrollo Web' : 'Web Development Professor'}</p></div>
          <div data-reveal><span>2020 — 2022</span><strong>Garaje de Ideas / Vidoomy</strong><p>Frontend Developer</p></div>
        </div>
      </section>

      <section id="contact" class="contact-panel" data-motion-section aria-labelledby="contact-title">
        <span class="contact-arrow" aria-hidden="true">↗</span>
        <div class="section-kicker">07 / {copy.nav[2]}</div>
        <p class="availability"><span aria-hidden="true"></span>{copy.available}</p>
        <h2 id="contact-title" data-reveal>{es ? 'Hagamos algo que importe.' : 'Let’s make something matter.'}</h2>
        <div class="contact-actions"><a href="mailto:deruvodaniel@gmail.com">{copy.contact} ↗</a><a href="https://www.linkedin.com/in/deruvodaniel/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="/De_Ruvo_Daniel_Resume_2026.pdf" download>{copy.resume} ↓</a></div>
      </section>
    </main>
    <footer><span class="wordmark" aria-label="ddra">ddra<span aria-hidden="true"></span></span><span>Daniel De Ruvo</span><a href="https://github.com/deruvodaniel" target="_blank" rel="noreferrer">GitHub ↗</a><small>{copy.note}</small></footer>
  </div>
  <button class="motion-toggle" type="button" aria-pressed="false" data-motion-toggle hidden><span aria-hidden="true">Ⅱ</span><span data-motion-label>{es ? "Pausar movimiento" : "Pause motion"}</span></button>
</BaseLayout>
